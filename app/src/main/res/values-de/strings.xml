  <string name="telegram_community">Der Telegram-Community beitreten</string>
      
  <string name="telegram_community_description">Erhalte App-Neuigkeiten, teste frühe Versionen und hilf beim Prüfen neuer Funktionen. Teile Ideen, stelle Fragen und erhalte schnelle Antworten.</string>
      
  <string name="onb_1_headline">John Conway</string>
      
  <string name="onb_1_description">1970 entwickelte der Mathematiker John Conway das Spiel des Lebens, einen zellulären Automaten, in dem jede Zelle wenigen einfachen Regeln folgt.</string>
      
  <string name="onb_2_headline">Regel 1</string>
      
  <string name="onb_2_description">Eine tote Zelle mit genau drei lebenden Nachbarn wird lebendig.</string>
      
  <string name="onb_3_headline">Regel 2</string>
      
  <string name="onb_3_description">Eine lebende Zelle überlebt mit zwei oder drei lebenden Nachbarn. Andernfalls stirbt sie an Unter- oder Überbevölkerung.</string>

