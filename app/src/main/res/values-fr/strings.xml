  <string name="telegram_community">Rejoindre la communauté Telegram</string>
      
  <string name="telegram_community_description">Suivez les actualités de l’application, essayez les versions anticipées et aidez à tester les nouvelles fonctionnalités. Partagez vos idées, posez vos questions et obtenez des réponses rapides.</string>
      
  <string name="onb_1_headline">John Conway</string>
      
  <string name="onb_1_description">En 1970, le mathématicien John Conway a imaginé le Jeu de la vie, un automate cellulaire dans lequel chaque cellule suit quelques règles simples.</string>
      
  <string name="onb_2_headline">Règle 1</string>
      
  <string name="onb_2_description">Une cellule morte ayant exactement trois voisines vivantes devient vivante.</string>
      
  <string name="onb_3_headline">Règle 2</string>
      
  <string name="onb_3_description">Une cellule vivante survit si elle a deux ou trois voisines vivantes. Sinon, elle meurt de sous-population ou de surpopulation.</string>

