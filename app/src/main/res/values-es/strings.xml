  <string name="telegram_community">Únete a la comunidad de Telegram</string>
      
  <string name="telegram_community_description">Sigue las novedades de la aplicación, prueba versiones anticipadas y ayuda a comprobar nuevas funciones. Comparte ideas, haz preguntas y recibe respuestas rápidas.</string>
      
  <string name="onb_1_headline">John Conway</string>
      
  <string name="onb_1_description">En 1970, el matemático John Conway ideó el Juego de la Vida, un autómata celular en el que cada célula sigue unas pocas reglas sencillas.</string>
      
  <string name="onb_2_headline">Regla 1</string>
      
  <string name="onb_2_description">Una célula muerta con exactamente tres vecinas vivas cobra vida.</string>
      
  <string name="onb_3_headline">Regla 2</string>
      
  <string name="onb_3_description">Una célula viva sobrevive si tiene dos o tres vecinas vivas. De lo contrario, muere por subpoblación o sobrepoblación.</string>

