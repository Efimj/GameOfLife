  <string name="telegram_community">Unisciti alla community Telegram</string>
      
  <string name="telegram_community_description">Segui gli aggiornamenti dell’app, prova le versioni in anteprima e aiuta a testare le nuove funzionalità. Condividi idee, fai domande e ricevi risposte rapide.</string>
      
  <string name="onb_1_headline">John Conway</string>
      
  <string name="onb_1_description">Nel 1970 il matematico John Conway ideò il Gioco della vita, un automa cellulare in cui ogni cellula segue poche semplici regole.</string>
      
  <string name="onb_2_headline">Regola 1</string>
      
  <string name="onb_2_description">Una cellula morta con esattamente tre vicine vive diventa viva.</string>
      
  <string name="onb_3_headline">Regola 2</string>
      
  <string name="onb_3_description">Una cellula viva sopravvive se ha due o tre vicine vive. Altrimenti muore per sottopopolazione o sovrappopolazione.</string>

