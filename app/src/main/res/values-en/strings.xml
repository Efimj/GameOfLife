    <string name="onb_1_headline">John Conway</string>
    <string name="onb_1_description">In 1970, mathematician John Conway devised the Game of Life, a cellular automaton in which every cell follows a few simple rules.</string>
    <string name="onb_2_headline">Rule 1</string>
    <string name="onb_2_description">A dead cell with exactly three live neighbors becomes alive.</string>
    <string name="onb_3_headline">Rule 2</string>
    <string name="onb_3_description">A live cell survives if it has two or three live neighbors. Otherwise, it dies from underpopulation or overpopulation.</string>
