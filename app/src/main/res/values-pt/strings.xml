  <string name="telegram_community">Participe da comunidade no Telegram</string>
      
  <string name="telegram_community_description">Acompanhe as novidades do aplicativo, experimente versões antecipadas e ajude a testar novos recursos. Compartilhe ideias, faça perguntas e receba respostas rápidas.</string>
      
  <string name="onb_1_headline">John Conway</string>
      
  <string name="onb_1_description">Em 1970, o matemático John Conway criou o Jogo da Vida, um autômato celular no qual cada célula segue algumas regras simples.</string>
      
  <string name="onb_2_headline">Regra 1</string>
      
  <string name="onb_2_description">Uma célula morta com exatamente três vizinhas vivas se torna viva.</string>
      
  <string name="onb_3_headline">Regra 2</string>
      
  <string name="onb_3_description">Uma célula viva sobrevive se tiver duas ou três vizinhas vivas. Caso contrário, morre por subpopulação ou superpopulação.</string>

