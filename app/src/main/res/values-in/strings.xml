    <string name="JohnHortonConway">John Horton Conway</string>

    <string name="JohnHortonConway_card_description">John Horton Conway adalah matematikawan Inggris yang memberikan kontribusi besar pada teori grup, teori simpul, teori bilangan, teori permainan kombinatorial, dan teori pengodean. Ia dikenal luas sebagai pencipta Game of Life Conway.</string>

    <string name="the_game_of_life">Game of Life Conway</string>

    <string name="GameOfLife_large_description">Game of Life Conway, yang sering disebut “Life”, adalah automaton seluler yang dirancang oleh matematikawan John Horton Conway pada tahun 1970. Ini adalah permainan tanpa pemain: setelah pola awal ditetapkan, perkembangannya sepenuhnya ditentukan oleh aturan. Sistem ini lengkap secara Turing dan mampu melakukan komputasi universal.</string>

