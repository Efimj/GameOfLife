    <string name="telegram_community">Bergabung dengan komunitas Telegram</string>

    <string name="telegram_community_description">Ikuti kabar aplikasi, coba build awal, dan bantu menguji fitur baru. Bagikan ide, ajukan pertanyaan, dan dapatkan jawaban dengan cepat.</string>

    <string name="onb_1_headline">John Conway</string>

    <string name="onb_1_description">Pada tahun 1970, matematikawan John Conway merancang Game of Life, automaton seluler dengan setiap sel yang mengikuti beberapa aturan sederhana.</string>

    <string name="onb_2_headline">Aturan 1</string>

    <string name="onb_2_description">Sel mati dengan tepat tiga tetangga hidup akan menjadi hidup.</string>

    <string name="onb_3_headline">Aturan 2</string>

    <string name="onb_3_description">Sel hidup akan bertahan jika memiliki dua atau tiga tetangga hidup. Jika tidak, sel tersebut mati karena kekurangan atau kelebihan populasi.</string>

